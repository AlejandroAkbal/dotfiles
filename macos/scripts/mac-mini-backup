#!/bin/zsh
set -euo pipefail
umask 077
export PATH="/opt/homebrew/bin:/usr/bin:/bin"

repo='rclone:macmini-backup:MacMini-Backup-Encrypted/repository'
restic=(/opt/homebrew/bin/restic -o rclone.program=/opt/homebrew/bin/rclone -r "$repo")
exclude="$HOME/.config/restic/macmini-excludes.txt"
logdir="$HOME/.local/state/mac-mini-backup"
log="$logdir/backup.log"
state_file="$logdir/status"
orbctl=/usr/local/bin/orbctl
orb_backup_dir="$HOME/OrbStack-Backup"
orb_archive="$orb_backup_dir/coolify-node.tar.zst"
orb_temp="/tmp/mac-mini-backup-coolify-node.$$.tar.zst"

mkdir -p "$logdir"
lock="$logdir/backup.lock"
exec 9>>"$lock"
if ! /usr/bin/lockf -s -t 0 9; then exit 0; fi
trap '/bin/rm -f "$orb_temp"' EXIT
export RESTIC_PASSWORD_COMMAND="/usr/bin/security find-generic-password -a $(/usr/bin/id -un) -s macmini-restic-backup -w"

notify_failure() {
  local stage="$1"
  local exit_code="$2"
  local ts="$3"
  local email_recipient="alexromero652@gmail.com"
  local email_script="$HOME/.hermes/scripts/send-email.py"
  
  if [[ -x "$email_script" ]]; then
    local recent_log
    recent_log="$(tail -n 35 "$log" 2>/dev/null || true)"
    local body="Mac mini daily backup failed during stage: ${stage} (exit code: ${exit_code}) at ${ts} UTC.

Recent log output:
----------------------------------------
${recent_log}
----------------------------------------

State file: ${state_file}
Log file: ${log}
Host: $(/bin/hostname -s)
"
    /usr/bin/python3 "$email_script" \
      --to "$email_recipient" \
      --subject "⚠️ [Alert] Mac mini backup failed (${stage})" \
      --body "$body" >>"$log" 2>&1 || true
  fi
}

# Full user-home backup. The exclude file removes only regenerable noise.
source="$HOME"

started=$(/bin/date -u +%FT%TZ)
printf 'status=running\nstarted=%s\n' "$started" >"$state_file"
printf '\n[%s] backup start\n' "$started" >>"$log"
# Best-effort: a transient repo timeout here must not abort the run before backup starts.
"${restic[@]}" unlock >>"$log" 2>&1 || true
mkdir -p "$orb_backup_dir"
rm -f "$orb_temp"
if "$orbctl" export coolify-node "$orb_temp" >>"$log" 2>&1; then
  mv -f "$orb_temp" "$orb_archive"
  chmod 600 "$orb_archive"
else
  rc=$?
  finished=$(/bin/date -u +%FT%TZ)
  printf '[%s] OrbStack export failure exit=%s\n' "$finished" "$rc" >>"$log"
  printf 'status=failure\nstarted=%s\nfinished=%s\nexit_code=%s\n' "$started" "$finished" "$rc" >"$state_file"
  notify_failure "OrbStack export" "$rc" "$finished"
  exit "$rc"
fi
if "${restic[@]}" backup --exclude-file="$exclude" --exclude-caches --exclude-cloud-files --skip-if-unchanged --tag mac-mini "$source" >>"$log" 2>&1; then
  if "${restic[@]}" forget --tag mac-mini --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune >>"$log" 2>&1; then
    subset="$(($(date +%j) % 100 + 1))/100"
    if "${restic[@]}" check --read-data-subset="$subset" >>"$log" 2>&1; then
      finished=$(/bin/date -u +%FT%TZ)
      printf '[%s] retention success policy=daily-7-weekly-4-monthly-6\n' "$finished" >>"$log"
      printf '[%s] integrity success subset=%s\n' "$finished" "$subset" >>"$log"
      printf '[%s] backup success\n' "$finished" >>"$log"
      printf 'status=success\nstarted=%s\nfinished=%s\n' "$started" "$finished" >"$state_file"
    else
      rc=$?
      finished=$(/bin/date -u +%FT%TZ)
      printf '[%s] integrity failure exit=%s subset=%s\n' "$finished" "$rc" "$subset" >>"$log"
      printf 'status=failure\nstarted=%s\nfinished=%s\nexit_code=%s\n' "$started" "$finished" "$rc" >"$state_file"
      notify_failure "Restic integrity check (subset ${subset})" "$rc" "$finished"
      exit "$rc"
    fi
  else
    rc=$?
    finished=$(/bin/date -u +%FT%TZ)
    printf '[%s] retention failure exit=%s\n' "$finished" "$rc" >>"$log"
    printf 'status=failure\nstarted=%s\nfinished=%s\nexit_code=%s\n' "$started" "$finished" "$rc" >"$state_file"
    notify_failure "Restic retention/prune" "$rc" "$finished"
    exit "$rc"
  fi
else
  rc=$?
  finished=$(/bin/date -u +%FT%TZ)
  printf '[%s] backup failure exit=%s\n' "$finished" "$rc" >>"$log"
  printf 'status=failure\nstarted=%s\nfinished=%s\nexit_code=%s\n' "$started" "$finished" "$rc" >"$state_file"
  notify_failure "Restic backup" "$rc" "$finished"
  exit "$rc"
fi
