# Copy to ~/.config/agent-secrets.env and fill in values.
# chmod 600 ~/.config/agent-secrets.env

export N8N_MCP_TOKEN="your-n8n-mcp-bearer-token"
export COOLIFY_MCP_AUTH_HEADER="Bearer your-coolify-api-token"

# Matomo MCP — token from Administration > Personal > Security > Auth Tokens
export MATOMO_API_TOKEN="your-matomo-auth-token"

# Google Search Console MCP — place OAuth client JSON at ~/.config/gsc/client_secrets.json
# https://github.com/AminForou/mcp-gsc#getting-started
